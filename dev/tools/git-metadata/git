#!/bin/sh
# Freeze only RMK's build metadata query, retaining the installed firmware's
# storage schema hash in this source snapshot without a Git history.
if [ "$#" -eq 5 ] && [ "$1" = log ] && [ "$2" = -1 ] && [ "$3" = '--format=%H' ] && [ "$4" = -- ] && [ "$5" = . ]; then
    printf '%s\n' 8a6889854fb996be592c55075b385234133e1772
else
    exec "${COREX_BUILD_REAL_GIT:-/usr/bin/git}" "$@"
fi
